    "preview": "vite preview --host --port 5173",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "matrix-js-sdk": "^35.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xumm-xapp-sdk": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.15"
  }
}
