{
  "name": "xaman-matrix-jwt-xapp-poc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "POC Matrix client xApp for Xaman, using Synapse legacy JWT login (org.matrix.login.jwt).",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite --host --port 5173",
